# Runtime / server
dev_frontend_origin=http://127.0.0.1:5173
dev_backend_origin=http://127.0.0.1:3000

# Storage
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Supabase cloud foundation (server-side values are configured in Vercel)
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_REALTIME_SIGNING_PRIVATE_JWK=
AUTH_ALLOWED_EMAIL_DOMAINS=example.com
# P1_PROFILE_ONLY=true
# Gemini user credentials are stored in Supabase Vault; no application encryption key is required.

# Gemini
# Server-only: do not rename this to VITE_GEMINI_API_KEY or expose it to the frontend.
GEMINI_API_KEY=
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
SAVED_RETRANSLATION_GEMINI_MODEL=gemini-3.5-flash

# Browser-safe Supabase values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Optional exact file path overrides. When unset, these files live under DATA_DIR.
# SESSION_RECORDS_FILE=./data/session-records.json
# SESSION_SHARES_FILE=./data/session-shares.json
# TRANSLATION_DURABLE_QUEUE_FILE=./data/translation-execution-queue.json
# TRANSLATION_DEAD_LETTER_QUEUE_FILE=./data/translation-execution-dead-letter-queue.json
# TRANSLATION_GLOSSARY_FILE=./data/translation-glossary.json
# Vercel Cron worker
# CRON_SECRET=
# WORKER_BATCH_SIZE=3
