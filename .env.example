# Runtime / server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=http://127.0.0.1:5173

# Storage
DATA_DIR=./data

# Gemini
# Server-only: do not rename this to VITE_GEMINI_API_KEY or expose it to the frontend.
GEMINI_API_KEY=
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
SAVED_RETRANSLATION_GEMINI_MODEL=gemini-3.5-flash

# Demo auth
DEMO_ACCESS_TOKEN=replace_with_a_long_random_demo_token
VITE_DEMO_ACCESS_TOKEN=replace_with_the_same_demo_token_for_browser_demo

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Optional exact file path overrides. When unset, these files live under DATA_DIR.
# SESSION_RECORDS_FILE=./data/session-records.json
# TRANSLATION_DURABLE_QUEUE_FILE=./data/translation-execution-queue.json
# TRANSLATION_DEAD_LETTER_QUEUE_FILE=./data/translation-execution-dead-letter-queue.json
# TRANSLATION_GLOSSARY_FILE=./data/translation-glossary.json
