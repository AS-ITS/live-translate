# live-translate v1.0.0：下列 URL 是 Local 手動啟動的範例值，不適用於雲端部署。
# npm run start 會自行取得本機 Supabase 設定並注入 Redis signaling，不需要根目錄 .env。
# 手動啟動時可複製本檔為 .env：Vite 會讀取 .env；Node API 需以 node --env-file=.env server/index.js 載入。
# Preview／Production 請在部署平台分別設定各自的 URL、key 與 Secret；見 docs/DEPLOYMENT.md。
# 其他進階選項見 docs/development.md#環境變數盤點。不要提交 .env 或真實 Secret。

# Local 預設允許 http://127.0.0.1:5173，不必設定 APP_ORIGIN。
# npm run start 會注入固定的前端 Origin，但不會偵測 Vite 實際綁定的 Origin。
# Preview／Production 須在部署平台明確設定各自可信任的 HTTPS APP_ORIGIN。
# APP_ORIGIN=http://127.0.0.1:5173
# Local 前端使用非預設 Origin 時，才覆寫 dev_frontend_origin。
# dev_frontend_origin=http://127.0.0.1:5173
# Local Vite API proxy 目標不是預設的 http://127.0.0.1:3000 時，才覆寫 dev_backend_origin。
# dev_backend_origin=http://127.0.0.1:3000

# Supabase：Local 值取自 npx supabase status -o json。
# SUPABASE_URL 供後端 REST／Auth 使用；VITE_SUPABASE_URL 供瀏覽器 Auth 使用。
# 兩者須指向同一個 Supabase Project；Preview／Production 各自使用對應 Project。
# SUPABASE_SECRET_KEY 僅供後端使用，絕不可加 VITE_ 前綴或提交到版本控制。
# 下列空白 key 佔位必須填入該環境的有效值；Local 分別使用 SERVICE_ROLE_KEY 與 ANON_KEY。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# 選填：空白表示不限制 Google 帳號的電子郵件網域；多個網域以逗號分隔。
AUTH_ALLOWED_EMAIL_DOMAINS=

# Viewer WebRTC signaling：npm run start 會自行注入本機 Redis 設定。
# 手動 Node 啟動需要可連線的 signaling 設定；未設定時 Viewer signaling 回 503。
# Local 使用 redis:// TCP URL，token 留空；先確認本機 Redis 已啟動。
# Preview／Production 必須改用 Redis HTTPS REST URL，並填入對應的 token。
# 絕不可把 redis://127.0.0.1:6379 用於 Preview／Production。
WEBRTC_SIGNALING_REDIS_URL=redis://127.0.0.1:6379
WEBRTC_SIGNALING_REDIS_TOKEN=
# 選填：STUN／TURN RTCIceServer[] JSON；若含 TURN credential，須視為 Secret。
# WEBRTC_ICE_SERVERS_JSON='[{"urls":"stun:stun.l.google.com:19302"}]'

# 正式 Meeting 的 Gemini API key 由 Host 在介面輸入，不需在此填 GEMINI_API_KEY。
# 以下均為選填；未設定時使用程式預設值。其餘進階選項見 docs/development.md。
# LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# LOCAL_MOCK_PROVIDER 僅供 npm run start 的隔離本機模式使用。
# LOCAL_MOCK_PROVIDER=true
# LIVE_TRANSLATE_DIAGNOSTICS=true
# VITE_TRANSCRIPT_POLISHING_ENABLED=false
# RATE_LIMIT_MAX=20
