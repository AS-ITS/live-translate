# 本機手動 Dev Server 與測試 Sample；完整步驟見 docs/development.md。
# npm run start 自行取得本機設定，不需要根目錄 .env。
# 複製為 .env 後，只填本機 Supabase CLI 回報的值；不要填雲端金鑰。
# Vite 自動讀 .env；Node API 須明確使用 node --env-file=.env 載入。
# 必要金鑰空白不是有效設定；網域白名單例外，空白表示不限制。
# Secret 只供後端使用，不得加 VITE_ 前綴。

# A. Application：完整網站 Origin。HTTPS 正式網址通常不需寫 port；
# 本機非預設 port 必須寫出，例如 http://127.0.0.1:5173。
APP_ORIGIN=http://127.0.0.1:5173
dev_frontend_origin=http://127.0.0.1:5173
dev_backend_origin=http://127.0.0.1:3000

# B. Supabase：npx supabase status -o json 的 API_URL、SERVICE_ROLE_KEY、ANON_KEY。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# 後端公開 REST 讀取的 fallback；已有 VITE_ key 時可省略。
# SUPABASE_PUBLISHABLE_KEY=

# C. Authentication：選填；空白不限制 Google 帳號的電子郵件網域。
# 有設定時，只允許清單內的完整網域（逗號分隔，忽略空白與大小寫）。
AUTH_ALLOWED_EMAIL_DOMAINS=
# 範例：AUTH_ALLOWED_EMAIL_DOMAINS=as.edu.tw
# 範例：AUTH_ALLOWED_EMAIL_DOMAINS=as.edu.tw,gmail.com
# Google Client Secret 放 supabase/.env.local（600），不放根目錄 .env。

# D. WebRTC / Redis：本機使用 TCP；雲端使用 HTTPS REST URL 加 token。
WEBRTC_SIGNALING_REDIS_URL=redis://127.0.0.1:6379
WEBRTC_SIGNALING_REDIS_TOKEN=
# 僅供 npm run start 覆寫本機 loopback TCP URL。
# LOCAL_REDIS_URL=redis://127.0.0.1:6379
# RTCIceServer 陣列；若包含 TURN credential，即視為 Secret。
# WEBRTC_ICE_SERVERS_JSON='[{"urls":"stun:stun.l.google.com:19302"}]'

# E. Gemini：正式 Meeting 的 key 由 Host 在介面輸入。
# 獨立 Worker 使用 Gemini provider 時，後端另需 GEMINI_API_KEY；
# 不屬於一般安裝 Sample，詳見 docs/development.md。
# LIVE_TRANSLATE_MODEL=
# LIVE_TRANSCRIPTION_MODEL=
# SAVED_RETRANSLATION_GEMINI_MODEL=
# SAVED_RETRANSLATION_TIMEOUT_MS=
# TRANSLATION_PROVIDER=gemini
# TRANSCRIPT_POLISHING_MODEL=
# TRANSCRIPT_POLISHING_MAX_RPM=15

# F. 測試與進階功能：需要時才取消註解。
# LOCAL_MOCK_PROVIDER=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=20
# LIVE_TRANSLATE_DIAGNOSTICS=false
# LIVE_PIPELINE_TRACE_ENABLED=false
# OBSERVABILITY_INSTANCE_ID=
# VITE_TRANSCRIPT_POLISHING_ENABLED=true
# VITE_TRANSCRIPT_POLISHING_INTERVAL_MS=30000
# VITE_TRANSCRIPT_POLISHING_MIN_CHARS=200
# VITE_TRANSCRIPT_POLISHING_MAX_RPM=15
# WORKER_BATCH_SIZE=3
# CRON_SECRET=
# SUPABASE_WORKER_USER_ID=
# SESSION_SNAPSHOT_MAX_BYTES=
# TRANSLATION_OUTPUT_MAX_BYTES=
# MEETING_CHECKPOINT_MAX_BYTES=
# SESSION_AUDIO_MAX_BYTES=
# DATA_DIR=
# SESSION_RECORDS_FILE=
# MEETING_RECORDS_FILE=
# SESSION_SHARES_FILE=
# RECORDER_LEASES_FILE=
# SESSION_AUDIO_DIR=
# TRANSLATION_GLOSSARY_FILE=
# TRANSLATION_DURABLE_QUEUE_FILE=
# TRANSLATION_DEAD_LETTER_QUEUE_FILE=
# LOCAL_SUPABASE_WORKDIR=
# 歷史 Realtime viewer：VITE_MEETING_VIEWER_REALTIME_ENABLED、
# SUPABASE_REALTIME_SIGNING_PRIVATE_JWK；不屬於主要安裝流程。
