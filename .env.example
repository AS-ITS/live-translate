# Deployment sample for separate Vercel Preview and Production environments.
# Copy values into the matching deployment environment; never copy cloud Supabase
# values into Local. `npm run start` obtains Local keys from Supabase CLI itself.
# Required below means required for the named capability; optional values may stay unset.
# Secret values belong only in server-side environment settings, never in VITE_*.
# Vercel supplies NODE_ENV, VERCEL_ENV, VERCEL_URL and VERCEL_BRANCH_URL;
# the Local launcher supplies LOCAL_SUPABASE_MODE and Local Supabase keys.

# Application / Origin
# Required Preview/Production; public. Exact browser origin for CORS and token requests.
APP_ORIGIN=https://YOUR_APP_HOST
# Optional manual development; public, not secret. Allowed frontend origin; launcher sets it.
# dev_frontend_origin=http://127.0.0.1:5173
# Optional manual development; public, not secret. Vite API proxy target; launcher sets it.
# dev_backend_origin=http://127.0.0.1:3000

# Supabase Server
# Required Preview/Production; server-only URL, not a secret. Same project as browser URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Required Preview/Production; SECRET. Supabase server/service key; never expose in VITE_*.
SUPABASE_SECRET_KEY=
# Required Preview/Production; server-only URL, not a secret. Must match SUPABASE_URL.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Optional Preview/Production legacy Realtime viewer; SECRET private JWK, server only.
# SUPABASE_REALTIME_SIGNING_PRIVATE_JWK=
# Optional Preview/Production worker ownership fallback; server-only user ID, not secret.
# SUPABASE_WORKER_USER_ID=

# Supabase Browser
# Required Preview/Production; public, not secret. Browser Supabase project URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Required Preview/Production; public, not secret. Browser publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional Preview/Production server REST fallback; public publishable key, not secret.
# SUPABASE_PUBLISHABLE_KEY=

# Authentication / Authorization
# Required Preview/Production; server-only policy, not a secret. Comma-separated domains.
AUTH_ALLOWED_EMAIL_DOMAINS=YOUR_WORKSPACE_DOMAIN
# Optional Preview/Production legacy profile-only mode; server-only, not secret. Default false.
# P1_PROFILE_ONLY=false
# Google OAuth Client Secret is configured in the matching Supabase Auth provider,
# not in Vercel or a VITE_* variable. Local uses supabase/.env.local.example.

# Gemini
# Optional Preview/Production server/worker Gemini fallback; SECRET, server only.
# Live recording normally uses the Host's request-scoped key.
# GEMINI_API_KEY=
# Optional Local/Preview/Production; server-only, not secret. Live translation model.
# LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# Optional Local/Preview/Production; server-only, not secret. Live transcription model.
# LIVE_TRANSCRIPTION_MODEL=
# Optional Preview/Production worker; server-only, not secret. Saved retranslation model.
# SAVED_RETRANSLATION_GEMINI_MODEL=gemini-3.5-flash
# Optional Preview/Production worker; server-only, not secret. Retranslation timeout in ms.
# SAVED_RETRANSLATION_TIMEOUT_MS=
# Optional Preview/Production; server-only, not secret. Transcript polishing model.
# TRANSCRIPT_POLISHING_MODEL=
# Optional Preview/Production; server-only, not secret. Polishing requests per minute.
# TRANSCRIPT_POLISHING_MAX_RPM=15

# WebRTC / Redis / TURN
# Required Preview/Production Viewer signaling; SECRET Redis HTTPS REST URL, server only.
WEBRTC_SIGNALING_REDIS_URL=
# Required Preview/Production Viewer signaling; SECRET Redis REST token, server only.
WEBRTC_SIGNALING_REDIS_TOKEN=
# Optional Preview/Production ICE/STUN/TURN JSON RTCIceServer array; server-only,
# SECRET when it contains TURN credentials. Needed when the network requires TURN.
# WEBRTC_ICE_SERVERS_JSON=
# Optional Local launcher override; loopback Redis URL, server-only, not secret.
# LOCAL_REDIS_URL=redis://127.0.0.1:6379

# Rate Limiting
# Optional Local/Preview/Production; server-only, not secret. Window in ms; default 60000.
# RATE_LIMIT_WINDOW_MS=60000
# Optional Local/Preview/Production; server-only, not secret. Max requests; default 20.
# RATE_LIMIT_MAX=20

# Diagnostics / Optional
# Optional isolated Preview; public build switch, not secret. Recording diagnostics.
# LIVE_TRANSLATE_DIAGNOSTICS=false
# Optional isolated Preview; public runtime switch, not secret. Pipeline trace.
# LIVE_PIPELINE_TRACE_ENABLED=false
# Optional Preview/Production; public build switch, not secret. Legacy viewer Realtime.
# VITE_MEETING_VIEWER_REALTIME_ENABLED=true
# Optional Preview/Production; public build switch, not secret. Transcript polishing.
# VITE_TRANSCRIPT_POLISHING_ENABLED=true
# Optional Preview/Production; public build setting, not secret. Polishing interval in ms.
# VITE_TRANSCRIPT_POLISHING_INTERVAL_MS=30000
# Optional Preview/Production; public build setting, not secret. Minimum text length.
# VITE_TRANSCRIPT_POLISHING_MIN_CHARS=200
# Optional Preview/Production; public build setting, not secret. Browser RPM limit.
# VITE_TRANSCRIPT_POLISHING_MAX_RPM=15
# Optional Preview/Production; server-only, not secret. Log instance identifier.
# OBSERVABILITY_INSTANCE_ID=
# Optional Preview/Production; server-only, not secret. Session snapshot byte cap.
# SESSION_SNAPSHOT_MAX_BYTES=
# Optional Preview/Production; server-only, not secret. Translation output byte cap.
# TRANSLATION_OUTPUT_MAX_BYTES=
# Optional Preview/Production; server-only, not secret. Checkpoint byte cap.
# MEETING_CHECKPOINT_MAX_BYTES=
# Optional Preview/Production; server-only, not secret. Audio artifact byte cap.
# SESSION_AUDIO_MAX_BYTES=
# Optional Local/Preview/Production; server-only, not secret. Base file storage path.
# DATA_DIR=
# Optional Local/Preview/Production; server-only, not secret. Session records path.
# SESSION_RECORDS_FILE=
# Optional Local/Preview/Production; server-only, not secret. Meeting records path.
# MEETING_RECORDS_FILE=
# Optional Local/Preview/Production; server-only, not secret. Session shares path.
# SESSION_SHARES_FILE=
# Optional Local/Preview/Production; server-only, not secret. Recorder leases path.
# RECORDER_LEASES_FILE=
# Optional Local/Preview/Production; server-only, not secret. Session audio path.
# SESSION_AUDIO_DIR=
# Optional Local/Preview/Production; server-only, not secret. Translation glossary path.
# TRANSLATION_GLOSSARY_FILE=
# Optional Local/Preview/Production; server-only, not secret. Durable queue path.
# TRANSLATION_DURABLE_QUEUE_FILE=
# Optional Local/Preview/Production; server-only, not secret. Dead-letter queue path.
# TRANSLATION_DEAD_LETTER_QUEUE_FILE=
# Optional Local launcher override; server-side path, not secret. Separate Supabase workdir.
# LOCAL_SUPABASE_WORKDIR=
