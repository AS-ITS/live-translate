{
  "name": "live-translate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "server": "node server/index.js",
    "start": "node scripts/start-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "start:production": "node server/index.js --production",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:lint": "npx supabase db lint",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --loader ./tests/fixtures/mockGoogleGenAiLoader.mjs --test tests/integration/*.test.js",
    "test:integration:supabase-rls": "RUN_SUPABASE_RLS_TESTS=true node --test tests/integration/supabaseRls.integration.test.js",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:e2e:cloud": "playwright test --config tests/e2e/playwright.cloud.config.js",
    "test:cloud:preflight": "node scripts/deployment-preflight.js",
    "test:live-smoke": "./scripts/live-meeting-smoke.sh",
    "test:deployment-preflight": "node scripts/deployment-preflight.js",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "deploy:supabase": "bash scripts/deploy-supabase-migrations.sh",
    "check": "node --check server/index.js && node --check server/tokenService.js && node --check src/lib/audio.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.11",
    "@vitejs/plugin-react": "^6.0.3",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "downshift": "^9.4.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tus-js-client": "^4.3.1",
    "vite": "^8.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "description": "Browser-based live speech translation and meeting subtitles with host-local recording and WebRTC viewer delivery.",
  "author": "Po-Chun Ruan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AS-ITS/live-translate.git"
  }
}
