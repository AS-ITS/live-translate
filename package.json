{
  "name": "live-translate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "server": "node server/index.js",
    "start": "node server/index.js --production",
    "start:production": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --loader ./tests/fixtures/mockGoogleGenAiLoader.mjs --test tests/integration/*.test.js",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:live-smoke": "node scripts/live-smoke-test.js",
    "check": "node --check server/index.js && node --check server/tokenService.js && node --check src/lib/audio.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
